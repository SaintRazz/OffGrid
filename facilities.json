    {
      "id": "bsfl-reactor",
      "name": "BSFL reactor",
      "image": "BSFLReactor.png",
      "width": 1,
      "height": 1,
      "market_price": 500,
      "inputs": {
        "kitchen_waste": {
          "mode": "feedstock"
        }
      },
      "outputs": {
        "insect_forage": {
          "mode": "self_harvested_mature_larvae",
          "unit": "lb"
        },
        "organic_residue": {
          "mode": "frass_and_indigestible_residue",
          "unit": "lb"
        }
      },
      "labor": {
        "accrual_rate_per_day": 0.1,
        "attention_threshold_hours": null
      },
      "degradation_rate_per_year": 0,
      "container": {
        "type": "kitchen_waste_feedstock",
        "physical_volume_ft3": 40,
        "approx_physical_volume_gal": 300,
        "usable_capacity_lb": 60
      },
      "process": {
        "feeding_rate_lb_feed_per_lb_larvae_per_day": 1.3,
        "maximum_growth_rate_per_day": 0.45,
        "larval_yield_fraction": 0.35,
        "residue_yield_fraction": 0.35,
        "untracked_loss_fraction": 0.3,
        "self_harvest_rate_per_day": 0.08,
        "maximum_larval_biomass_lb": 20,
        "maximum_processing_rate_lb_per_day": 26,
        "process_states": [
          "feedstock_mass",
          "larval_biomass",
          "residue_mass"
        ]
      },
      "construction": {
        "materials": {},
        "labor_hours": null,
        "energy_kwh": null,
        "prerequisites": []
      },
      "notes": [
        "Physical bin dimensions are approximately 4 ft x 4 ft x 2.5 ft (about 40 ft3 gross volume).",
        "Working surface is approximately 16 ft2; only a shallow active substrate layer is assumed so most gross volume remains available for ventilation, heat dissipation, drainage, and self-harvest geometry.",
        "Usable feedstock capacity is 60 lb and maximum standing larval biomass is 20 lb.",
        "At maximum larval biomass, nominal feed-processing capacity is 26 lb/day (20 lb larvae x 1.3 lb feed/lb larvae/day).",
        "Of processed feed, nominal mass balance is 35% new larval biomass, 35% frass/organic residue, and 30% untracked metabolic, gaseous, and evaporative losses.",
        "Larval growth is additionally capped at 0.45 of standing biomass per day; the 1.3 feed rate and 0.35 yield were intentionally chosen to closely match that ceiling.",
        "Self-harvest is modeled as 0.08 of standing larval biomass per day, scaled by feeding activity; no feed means no modeled growth or maturation loss.",
        "Routine reactor tending accrues 0.1 labor-hours/day; collection and transport of feedstocks are accounted for elsewhere."
      ]
    },
